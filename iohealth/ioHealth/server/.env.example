# Copy to .env and fill in. .env is git-ignored; never commit it.

# --- The health data: MariaDB / MySQL (required) ---
DB_HOST=mariadb.example.lan
DB_PORT=3306
DB_USER=health
DB_PASSWORD=
# Created on first start if the user is allowed to; otherwise it must already exist.
DB_NAME=health

# --- The accounts and suite-wide settings: the Shared ioSuite database (iothing-auth), the same one ioPix, ioNotes
# and ioContacts use. Same server as the health data unless told otherwise.
# IOTHING_AUTH_DB_HOST=mariadb.example.lan
# IOTHING_AUTH_DB_PORT=3306
IOTHING_AUTH_DB_NAME=iosuite
IOTHING_AUTH_DB_USER=iosuite
IOTHING_AUTH_DB_PASSWORD=
# The domain the session cookie is shared on: signed in at photo.example.com is signed in at health.example.com too.
# IOTHING_COOKIE_DOMAIN=example.com

# The first account on an empty Shared ioSuite database (remove both to create it from the sign-in screen instead).
# ADMIN_USER=alex
# ADMIN_PASSWORD=

# The address the suite's start page and the other apps link to. Empty: the best address ioHealth is reached at.
# PUBLIC_URL=https://health.example.com

# UPDATE_CHECK=0: never ask GitHub whether a newer version exists (Maintenance › ioHealth version has the daily check).
# UPDATE_CHECK=1

# Fallback time zone for days and weeks (the browser normally sends its own), e.g. Europe/Brussels.
# TZ=
# Map tiles for workout routes; OpenStreetMap by default.
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors

# Sign-in at a reverse proxy (Cloudflare Access...): AUTH_PROXY, CF_ACCESS_TEAM, CF_ACCESS_AUD, AUTH_PROXY_HEADER,
# AUTH_PROXY_TRUSTED, AUTH_PROXY_CREATE; see the README. Also settable from Settings in the web app.

# Optional: serve HTTPS directly instead of behind a reverse proxy (mount the files into the container).
# TLS_CERT_FILE=/certs/fullchain.pem
# TLS_KEY_FILE=/certs/privkey.pem
