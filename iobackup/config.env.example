# ioBackup settings. Copy this file to config.env in the app folder (setup.sh writes one for you) and fill it in.
# Variables already in the environment (a container's, a service's) win over this file. config.env holds passwords:
# keep it readable by the owner only (chmod 600), and never commit it. Every app of the suite reads the same names.

# --- The app's own database: MariaDB / MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=backup
DB_USER=backup
DB_PASSWORD=

# --- The Shared ioSuite database: accounts, sessions and suite-wide settings, shared by every app of the suite.
# Same server as DB_HOST / DB_PORT unless set.
# IOSUITE_DB_HOST=
# IOSUITE_DB_PORT=3306
IOSUITE_DB_NAME=iosuite
IOSUITE_DB_USER=iosuite
IOSUITE_DB_PASSWORD=

# --- Where people reach it
# The address people and the other apps reach ioBackup at (behind a reverse proxy). Empty: the address it is reached at.
# PUBLIC_URL=https://backup.example.com
# where ioBackup is inside the network, kept in the suite's list of apps for reference (empty: this host's LAN address and PORT)
# INTERNAL_URL=http://192.168.1.151:8680
# The domain the sign-in is shared on: signed in at one app under it, signed in at all of them. Empty: this host only.
# COOKIE_DOMAIN=example.com
# Where the server listens. Every app has its own default port, so all of them can run on one host.
# HOST: every address of this machine by default (0.0.0.0). Or:
#   HOST=127.0.0.1                 this machine only, behind a reverse proxy on this same server: the proxy is the
#                                  only way in, and the suite's other apps on this server still reach it directly
#   HOST=192.168.1.151             one address, when the machine has several
#   HOST=127.0.0.1,192.168.1.151   several of them
# (Docker: leave HOST alone and publish the port where you want it, "127.0.0.1:PORT:PORT".)
# HOST=0.0.0.0
PORT=8680
# HTTPS served directly instead of behind a reverse proxy: both files.
# TLS_CERT_FILE=/certs/fullchain.pem
# TLS_KEY_FILE=/certs/privkey.pem

# --- Accounts
# The first admin, made on the first start when there is no account yet (or make it in the browser).
# ADMIN_USER=admin
# ADMIN_PASSWORD=
# Sign-in at a reverse proxy (Cloudflare Access, Authelia...) is one setting for the whole suite, kept in the Shared
# ioSuite database (start page: Settings › Global settings › Keys and tokens) and read only from there. Set here, a value is ignored: on the next
# start it only fills an empty shared setting, and its line is commented out. CF_ACCESS_AUD: one or several AUD tags.
# AUTH_PROXY=cloudflare
# AUTH_PROXY_HEADER=
# AUTH_PROXY_TRUSTED=127.0.0.1,::1
# AUTH_PROXY_CREATE=
# CF_ACCESS_TEAM=myteam.cloudflareaccess.com
# CF_ACCESS_AUD=

# --- Running it
# Time zone, e.g. Europe/Brussels.
# TZ=
# Where the app writes on its own (the log, the update result): data/ in the app folder unless set.
# DATA_DIR=
# The server log shown at Settings › Server: DATA_DIR/iobackup.log (LOG_FILE= with nothing after it: no file).
# LOG_FILE=
# UPDATE_CHECK=0 never asks GitHub whether a newer version exists.
# UPDATE_CHECK=1
# What update.sh and the version check follow.
# IOBACKUP_REPO=avandeputte/iosuite
# IOBACKUP_BRANCH=main

# --- ioBackup's own
# The folder a new local destination suggests (made when missing; the Docker image mounts a volume at /backups).
# BACKUP_DIR=/var/backups/iobackup
# Where a backup is put together before it is stored (room for two compressed backups): DATA_DIR/work unless set.
# WORK_DIR=
# Where a backup read from Google Drive is kept while it is restored: DATA_DIR/cache unless set.
# CACHE_DIR=
# BACKGROUND=0 turns the queue and the scheduler off (nothing runs and no schedule fires), e.g. for a second copy of the app.
# BACKGROUND=1
# Schedules run in TZ above (or the host's time zone).
# The servers' passwords and the Google keys are not kept here: they are entered in ioBackup (Servers, Destinations)
# and kept with the suite's keys and tokens in the Shared ioSuite database.
