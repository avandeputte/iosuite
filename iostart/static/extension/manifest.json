{
  "manifest_version": 3,
  "name": "ioStart Bookmarks",
  "version": "1.0.4",
  "description": "Keeps this browser's bookmarks the same as your ioStart page's, both ways.",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["bookmarks", "storage", "alarms"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js", "scripts": ["sync.js", "background.js"] },
  "action": { "default_title": "ioStart Bookmarks", "default_popup": "popup.html", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "minimum_chrome_version": "121",
  "browser_specific_settings": { "gecko": { "id": "bookmarks@iosuite", "strict_min_version": "128.0", "data_collection_permissions": { "required": ["bookmarksInfo"] } } }
}
