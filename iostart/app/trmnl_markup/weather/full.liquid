<div class="layout layout--row layout--top layout--stretch-x">
  {%- if missing %}<div class="flex flex--col flex--center w--full"><span class="description">{{ missing }}</span></div>{% endif %}
  {%- unless missing %}
  <div class="grid grid--cols-12 w--full">
    <div class="col--span-4 flex flex--col flex--left gap">
      <div class="flex flex--col flex--left gap--small">
        <div class="flex flex--row flex--left gap">
          <img class="image w--16 h--16" src="data:image/svg+xml;base64,{{ wx_open | append: wx[icon] | append: '</svg>' | base64_encode }}">
          <span class="value value--xxlarge">{{ temp }}</span>
        </div>
        <span class="title">{{ text }}</span>
        {%- if hi != "" %}<span class="label">High {{ hi }} &middot; Low {{ lo }}</span>{% endif %}
        {%- if feels != "" %}<span class="label">Feels like {{ feels }}</span>{% endif %}
        {%- if note != "" %}<span class="label label--inverted">{{ note }}</span>{% endif %}
      </div>
      <div class="flex flex--col flex--left gap--xsmall">
        {%- if wind != "" %}<span class="label label--small label--gray">Wind {{ wind }}</span>{% endif %}
        {%- if humidity != "" %}<span class="label label--small label--gray">Humidity {{ humidity }}</span>{% endif %}
        {%- if uv != "" %}<span class="label label--small label--gray">UV index {{ uv }}</span>{% endif %}
      </div>
    </div>
    <div class="col--span-8 flex flex--col flex--left gap">
      {%- if hours.size > 0 %}
      <div class="flex flex--col flex--left gap--small w--full">
        <span class="label label--underline">The next hours</span>
        <div class="flex flex--row flex--between w--full">
        {%- for h in hours limit: 8 %}
        <div class="flex flex--col flex--center gap--xsmall">
          <span class="label label--small">{{ h.time }}</span>
          <img class="image w--10 h--10" src="data:image/svg+xml;base64,{{ wx_open | append: wx[h.icon] | append: '</svg>' | base64_encode }}">
          <span class="title title--small">{{ h.temp }}</span>
          <span class="label label--small label--gray">{% if h.rain != "" %}{{ h.rain }}{% else %}&nbsp;{% endif %}</span>
        </div>
        {%- endfor %}
      </div>
      </div>
      {%- endif %}
      <div class="flex flex--col flex--left gap--small w--full">
        <span class="label label--underline">The coming days</span>
        {%- for d in days %}
        <div class="grid grid--cols-12 w--full">
          <div class="col--span-2 flex flex--row flex--left"><span class="title title--small">{{ d.day }}</span></div>
          <div class="col--span-1 flex flex--row flex--left"><img class="image w--8 h--8" src="data:image/svg+xml;base64,{{ wx_open | append: wx[d.icon] | append: '</svg>' | base64_encode }}"></div>
          <div class="col--span-5 flex flex--row flex--left"><span class="label" data-clamp="1">{{ d.text }}</span></div>
          <div class="col--span-2 flex flex--row flex--left"><span class="label label--gray">{{ d.rain }}</span></div>
          <div class="col--span-2 flex flex--row flex--right"><span class="label">{{ d.hi }} / {{ d.lo }}</span></div>
        </div>
        {%- endfor %}
      </div>
    </div>
  </div>
  {%- endunless %}
</div>
<div class="title_bar">
  <img class="image" src="{{ iosuite_icon }}">
  <span class="title">Weather</span>
  <span class="instance">{% if place != "" %}{{ place }} &middot; {% endif %}updated {{ updated }}</span>
</div>
