<div class="layout layout--col layout--top layout--stretch-x gap">
  {%- if missing %}<div class="flex flex--col flex--center w--full"><span class="description">{{ missing }}</span></div>{% endif %}
  {%- unless missing %}
  <div class="flex flex--col flex--left">
    <span class="value value--large" data-fit-value="true">{{ steps }}</span>
    <span class="label">steps today{% if average != "" %} &middot; {{ average }} a day this week{% endif %}</span>
  </div>
  {%- if sleep != "" %}<div class="flex flex--col flex--left"><span class="value value--small">{{ sleep }}</span><span class="label">asleep last night</span></div>{% endif %}
  {%- for r in rings %}
      <div class="progress-bar progress-bar--small w--full">
        <div class="content"><span class="label label--small">{{ r.name }}</span><span class="label label--small">{{ r.value }}{% if r.goal != "" %} / {{ r.goal }}{% endif %} {{ r.unit }}</span></div>
        <div class="track"><div class="fill" style="width: {{ r.pct }}%"></div></div>
      </div>
      {%- endfor %}
  {%- endunless %}
</div>
<div class="title_bar">
  <img class="image" src="{{ iosuite_icon }}">
  <span class="title">Health</span>
  <span class="instance">{{ updated }}</span>
</div>
