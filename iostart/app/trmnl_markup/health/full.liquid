<div class="layout layout--row layout--top layout--stretch-x">
  {%- if missing %}<div class="flex flex--col flex--center w--full"><span class="description">{{ missing }}</span></div>{% endif %}
  {%- unless missing %}
  <div class="grid grid--cols-12 w--full">
    <div class="col--span-5 flex flex--col flex--left gap">
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="value value--xxlarge" data-fit-value="true">{{ steps }}</span>
          <span class="label">steps today{% if average != "" %} &middot; {{ average }} a day this week{% endif %}</span>
        </div>
      </div>
      {%- if sleep != "" %}
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="value value--small">{{ sleep }}</span>
          <span class="label">asleep last night{% if in_bed != "" %} &middot; {{ in_bed }} in bed{% endif %}</span>
        </div>
      </div>
      {%- endif %}
      {%- for r in rings %}
      <div class="progress-bar progress-bar--small w--full">
        <div class="content"><span class="label label--small">{{ r.name }}</span><span class="label label--small">{{ r.value }}{% if r.goal != "" %} / {{ r.goal }}{% endif %} {{ r.unit }}</span></div>
        <div class="track"><div class="fill" style="width: {{ r.pct }}%"></div></div>
      </div>
      {%- endfor %}
    </div>
    <div class="col--span-7 flex flex--col flex--left gap--small">
      <span class="label label--underline">The last seven days</span>
      {%- for w in week %}
      <div class="progress-bar progress-bar--xsmall w--full">
        <div class="content"><span class="label label--small">{{ w.day }}</span><span class="label label--small">{{ w.steps }}</span></div>
        <div class="track"><div class="fill" style="width: {{ w.pct }}%"></div></div>
      </div>
      {%- endfor %}
    </div>
  </div>
  {%- endunless %}
</div>
<div class="title_bar">
  <img class="image" src="{{ iosuite_icon }}">
  <span class="title">Health</span>
  <span class="instance">{{ date_short }} &middot; updated {{ updated }}</span>
</div>
