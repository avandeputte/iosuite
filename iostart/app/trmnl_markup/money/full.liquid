<div class="layout layout--row layout--top layout--stretch-x">
  {%- if missing %}<div class="flex flex--col flex--center w--full"><span class="description">{{ missing }}</span></div>{% endif %}
  {%- unless missing %}
  <div class="grid grid--cols-12 w--full">
    <div class="col--span-8 flex flex--col flex--left gap--small">
      <span class="label label--underline">Bills this week</span>
      {%- for b in bills limit: 10 %}
      <div class="flex flex--row flex--between w--full">
        <span class="title title--small" data-clamp="1">{{ b.day }} &middot; {{ b.name }}</span>
        <span class="title title--small">{{ b.amount }}</span>
      </div>
      {%- endfor %}
      {%- if bills.size == 0 %}<span class="description">No bills due this week</span>{% endif %}
      {%- if more > 0 %}<span class="label label--small label--gray">and {{ more }} more</span>{% endif %}
    </div>
    <div class="col--span-4 flex flex--col flex--left gap">
      {%- if total != "" %}
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="value value--small" data-fit-value="true">{{ total }}</span>
          <span class="label">due this week</span>
        </div>
      </div>
      {%- endif %}
      {%- for l in low %}<span class="label label--small label--inverted" data-clamp="1">{{ l }}</span>{% endfor %}
      {%- if behind.size > 0 %}<span class="label label--small label--gray" data-clamp="2">Not up to date: {{ behind | join: ", " }}</span>{% endif %}
    </div>
  </div>
  {%- endunless %}
</div>
<div class="title_bar">
  <img class="image" src="{{ iosuite_icon }}">
  <span class="title">Money</span>
  <span class="instance">{{ date_short }} &middot; updated {{ updated }}</span>
</div>
