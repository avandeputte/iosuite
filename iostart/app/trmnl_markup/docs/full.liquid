<div class="layout layout--col layout--top layout--stretch-x">
  {%- if missing %}<div class="flex flex--col flex--center w--full"><span class="description">{{ missing }}</span></div>{% endif %}
  {%- if items.size == 0 and missing == nil %}<div class="flex flex--col flex--center w--full"><span class="value value--small">Nothing to renew</span></div>{% endif %}
  <div class="columns" data-overflow="true" data-overflow-max-cols="2" data-overflow-counter="true">
    <div class="column">
      {%- for x in items limit: 10 %}
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="title title--small" data-clamp="1">{{ x.title }}</span>
          {%- if x.who != "" or x.kind != "" %}<span class="description" data-clamp="1">{{ x.kind }}{% if x.who != "" and x.kind != "" %} &middot; {% endif %}{{ x.who }}</span>{% endif %}
          <div class="flex gap--small">
            <span class="label label--small{% if x.expired %} label--inverted{% endif %}">{{ x.when }}</span>
            {%- if x.date != "" %}<span class="label label--small label--gray">{{ x.date }}</span>{% endif %}
          </div>
        </div>
      </div>
      {%- endfor %}
    </div>
  </div>
</div>
<div class="title_bar">
  <img class="image" src="{{ iosuite_icon }}">
  <span class="title">To renew</span>
  <span class="instance">{% if expired > 0 %}{{ expired }} expired &middot; {% endif %}{% if more > 0 %}{{ more }} more &middot; {% endif %}updated {{ updated }}</span>
</div>
