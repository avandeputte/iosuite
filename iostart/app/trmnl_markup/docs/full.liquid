{%- assign few = false %}{%- if items.size < 6 %}{%- assign few = true %}{%- endif %}
<div class="layout layout--col layout--top layout--stretch-x">
  {%- if missing %}<div class="flex flex--col flex--center w--full"><span class="description">{{ missing }}</span></div>{% endif %}
  {%- if items.size == 0 and missing == nil %}<div class="flex flex--col flex--center w--full"><span class="value value--small lg:value--base">Nothing to renew</span></div>{% endif %}
  <div class="columns" data-overflow="true" data-overflow-max-cols="2" data-overflow-counter="true">
    <div class="column">
      {%- for x in items limit: 10 %}
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="title title--small {% if few %}lg:text--xxlarge{% else %}lg:text--xlarge{% endif %} lg:text--bold" data-clamp="1">{{ x.title }}</span>
          {%- if x.who != "" or x.kind != "" %}<span class="description {% if few %}lg:description--xxlarge{% else %}lg:description--xlarge{% endif %}" data-clamp="1">{{ x.kind }}{% if x.who != "" and x.kind != "" %} &middot; {% endif %}{{ x.who }}</span>{% endif %}
          <div class="flex gap--small lg:gap--base">
            <span class="label label--small {% if few %}lg:label--xlarge{% else %}lg:label--large{% endif %}{% if x.expired %} label--error {{ on_grays }}{% endif %}">{{ x.when }}</span>
            {%- if x.date != "" %}<span class="label label--small label--gray {% if few %}lg:label--xlarge{% else %}lg:label--large{% endif %}">{{ x.date }}</span>{% endif %}
          </div>
        </div>
      </div>
      {%- endfor %}
    </div>
  </div>
</div>
<div class="title_bar">
  <img class="image" src="{{ iosuite_icon }}">
  <span class="title">To renew</span>
  <span class="instance">{% if expired > 0 %}{{ expired }} expired &middot; {% endif %}{% if more > 0 %}{{ more }} more &middot; {% endif %}updated {{ updated }}</span>
</div>
