<div class="layout layout--col layout--top layout--stretch-x">
  {%- if missing %}<div class="flex flex--col flex--center w--full"><span class="description">{{ missing }}</span></div>{% endif %}
  {%- if items.size == 0 and missing == nil %}<div class="flex flex--col flex--center w--full"><span class="value value--small lg:value--base">Nothing to renew</span></div>{% endif %}
  <div class="columns" data-overflow="true" data-overflow-max-cols="1" data-overflow-counter="true">
    <div class="column">
      {%- for x in items limit: 3 %}
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="title title--small lg:title--base lg:text--bold" data-clamp="1">{{ x.title }}</span>
          
          <div class="flex gap--small lg:gap--base">
            <span class="label label--small lg:label--base{% if x.expired %} label--error {{ on_grays }}{% endif %}">{{ x.when }}</span>
            
          </div>
        </div>
      </div>
      {%- endfor %}
    </div>
  </div>
</div>
<div class="title_bar">
  <img class="image" src="{{ iosuite_icon }}">
  <span class="title">To renew</span>
  <span class="instance"></span>
</div>
