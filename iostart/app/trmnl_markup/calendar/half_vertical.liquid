<div class="layout layout--col layout--top layout--stretch-x">
  {%- if missing %}<div class="flex flex--col flex--center w--full"><span class="description">{{ missing }}</span></div>{% endif %}
  <div class="columns" data-overflow="true" data-overflow-max-cols="1" data-overflow-counter="true">
    <div class="column">
      {%- for d in days limit: 4 %}
      {%- if d.events.size > 0 or forloop.first %}
      <span class="label label--underline group-header" data-group-header="true">{{ d.label }} &middot; {{ d.date }}</span>
      {%- for e in d.events limit: 4 %}
      <div class="item">
        <div class="meta">{% if e.ink != blank %}<div class="bg--{{ e.ink }} w--full h--full {{ inks_only }}"></div>{% endif %}</div>
        <div class="content">
          <span class="title title--small lg:title--base lg:text--bold" data-clamp="1">{{ e.title }}</span>
          <span class="label label--small lg:label--base" data-clamp="1">{{ e.time }}{% if e.place != "" %} @ {{ e.place }}{% endif %}</span>
        </div>
      </div>
      {%- endfor %}
      {%- if d.events.size == 0 %}<span class="label label--small label--gray lg:label--base">Nothing more today</span>{% endif %}
      {%- endif %}
      {%- endfor %}
    </div>
  </div>
</div>
<div class="title_bar">
  <img class="image" src="{{ iosuite_icon }}">
  <span class="title">Calendar</span>
  <span class="instance">{{ updated }}</span>
</div>
