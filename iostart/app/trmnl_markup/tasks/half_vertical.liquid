<div class="layout layout--col layout--top layout--stretch-x">
  {%- if missing %}<div class="flex flex--col flex--center w--full"><span class="description">{{ missing }}</span></div>{% endif %}
  {%- if tasks.size == 0 and missing == nil %}<div class="flex flex--col flex--center w--full"><span class="value value--small lg:value--base">Nothing due today</span></div>{% endif %}
  <div class="columns" data-overflow="true" data-overflow-max-cols="1" data-overflow-counter="true">
    <div class="column">
      {%- for t in tasks limit: 8 %}
      <div class="item">
        <div class="meta">{% if t.ink != blank %}<div class="bg--{{ t.ink }} w--full h--full {{ inks_only }}"></div>{% endif %}</div>
        <div class="content">
          <span class="title title--small lg:title--base lg:text--bold" data-clamp="1">{{ t.title }}</span>
          {%- if t.when != "" %}<span class="label label--small lg:label--base{% if t.late %} label--error {{ on_grays }}{% endif %}">{{ t.when }}</span>{% endif %}
        </div>
      </div>
      {%- endfor %}
    </div>
  </div>
</div>
<div class="title_bar">
  <img class="image" src="{{ iosuite_icon }}">
  <span class="title">Tasks today</span>
  <span class="instance">{% if overdue > 0 %}{{ overdue }} late{% endif %}</span>
</div>
