<div class="layout layout--row layout--top layout--stretch-x">
  <div class="grid grid--cols-12 w--full">
    <div class="col--span-3 flex flex--col flex--left gap--small lg:gap--base">
      <span class="value value--small lg:value--base">{{ weekday }}</span>
      <span class="label lg:label--large">{{ date }}</span>
      {%- if weather %}<span class="value value--small lg:value--base">{{ weather.temp }}</span><span class="label label--small lg:label--base" data-clamp="1">{{ weather.text }}</span>{% endif %}
    </div>
    <div class="col--span-5 flex flex--col flex--left gap--xsmall lg:gap--small">
      <span class="label label--underline lg:label--large">Today</span>
      {%- for e in events limit: 5 %}
      <span class="label lg:label--large{% if forloop.index > 3 %} hidden lg:block{% endif %}" data-clamp="1">{{ e.time }} &middot; {{ e.title }}</span>
      {%- if e.place != "" %}<span class="label label--small label--gray lg:label--base{% if forloop.index > 3 %} hidden lg:block{% endif %}" data-clamp="1">@ {{ e.place }}</span>{% endif %}
      {%- endfor %}
      {%- if events.size == 0 %}<span class="label label--small lg:label--base" data-clamp="2">{% if next != "" %}{{ next }}{% else %}Nothing more today{% endif %}</span>{% endif %}
    </div>
    <div class="col--span-4 flex flex--col flex--left gap--xsmall lg:gap--small">
      {%- if has_tasks %}
      <span class="label label--underline lg:label--large">Tasks{% if overdue > 0 %} &middot; {{ overdue }} late{% endif %}</span>
      {%- for t in tasks limit: 8 %}<span class="label lg:label--large{% if forloop.index > 4 %} hidden lg:block{% endif %}" data-clamp="1">{{ t.title }}</span>{% endfor %}
      {%- if tasks.size == 0 %}<span class="label label--small lg:label--base">Nothing due</span>{% endif %}
      {%- endif %}
    </div>
  </div>
</div>
<div class="title_bar">
  <img class="image" src="{{ iosuite_icon }}">
  <span class="title">Today</span>
  <span class="instance">updated {{ updated }}</span>
</div>
