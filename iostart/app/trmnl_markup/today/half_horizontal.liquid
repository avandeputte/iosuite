<div class="layout layout--col layout--top layout--stretch-x gap--small lg:gap--base">
  <div class="flex flex--row flex--between w--full">
    <div class="flex flex--row flex--left gap lg:gap--large">
      <span class="value value--small lg:value--base">{{ weekday }}</span>
      <span class="label lg:label--large">{{ date }}</span>
    </div>
    {%- if weather %}
    <div class="flex flex--row flex--right gap lg:gap--large">
      <span class="label label--small lg:label--base" data-clamp="1">{{ weather.text }}</span>
      <span class="value value--small lg:value--base">{{ weather.temp }}</span>
    </div>
    {%- endif %}
  </div>
  <div class="columns gap--[8px]" data-overflow="true" data-overflow-max-cols="3" data-overflow-counter="true">
    <div class="column">
      {%- for g in list %}
      <span class="label label--underline group-header" data-group-header="true">{{ g.label }}</span>
      {%- for r in g.rows %}
      <div class="item"><div class="content"><span class="title title--small lg:title--base" data-clamp="1">{{ r.when }} &middot; {{ r.title }}</span></div></div>
      {%- endfor %}
      {%- if g.rows.size == 0 %}<div class="item"><div class="content"><span class="title title--small lg:title--base">{{ none }}</span></div></div>{% endif %}
      {%- if g.more > 0 %}<div class="item"><div class="content"><span class="label label--small label--gray lg:label--base">and {{ g.more }} more today</span></div></div>{% endif %}
      {%- endfor %}
    </div>
  </div>
</div>
<div class="title_bar">
  <img class="image" src="{{ iosuite_icon }}">
  <span class="title">Today</span>
  <span class="instance">updated {{ updated }}</span>
</div>
