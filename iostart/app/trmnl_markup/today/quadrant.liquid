<div class="layout layout--col layout--top layout--stretch-x gap--small">
  <div class="flex flex--row flex--between w--full">
    <span class="title">{{ date_short }}</span>
    {%- if weather %}<span class="title">{{ weather.temp }}</span>{% endif %}
  </div>
  {%- for e in events limit: 3 %}
  <span class="label" data-clamp="1">{{ e.time }} &middot; {{ e.title }}</span>
  {%- endfor %}
  {%- if events.size == 0 %}<span class="label label--small" data-clamp="2">{% if next != "" %}{{ next }}{% else %}Nothing more today{% endif %}</span>{% endif %}
</div>
<div class="title_bar">
  <img class="image" src="{{ iosuite_icon }}">
  <span class="title">Today</span>
</div>
