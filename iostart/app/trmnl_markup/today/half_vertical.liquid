<div class="layout layout--col layout--top layout--stretch-x gap lg:gap--large">
  <div class="flex flex--row flex--between w--full">
    <div class="flex flex--col flex--left">
      <span class="value value--small lg:value--base">{{ weekday }}</span>
      <span class="label lg:label--large">{{ date }}</span>
    </div>
    {%- if weather %}
    <div class="flex flex--col flex--right">
      <span class="value value--small lg:value--base">{{ weather.temp }}</span>
      <span class="label label--small lg:label--base" data-clamp="1">{{ weather.text }}</span>
    </div>
    {%- endif %}
  </div>
  <div class="flex flex--col flex--left gap--small w--full lg:gap--base">
    <span class="label label--underline lg:label--large">Today</span>
    {%- for e in events limit: 6 %}
    <div class="item{% if forloop.index > 4 %} hidden lg:flex{% endif %}">
      <div class="meta"></div>
      <div class="content">
        <span class="title title--small lg:title--base lg:text--bold" data-clamp="1">{{ e.title }}</span>
        <span class="label label--small lg:label--base" data-clamp="1">{{ e.time }}{% if e.place != "" %} @ {{ e.place }}{% endif %}</span>
      </div>
    </div>
    {%- endfor %}
    {%- if events.size == 0 %}<span class="description">{% if next != "" %}{{ next }}{% else %}Nothing more today{% endif %}</span>{% endif %}
  </div>
  {%- if has_tasks %}
  <div class="flex flex--col flex--left gap--xsmall w--full lg:gap--small">
    <span class="label label--underline lg:label--large">Tasks{% if overdue > 0 %} &middot; {{ overdue }} late{% endif %}</span>
    {%- for t in tasks limit: 8 %}<span class="label lg:label--large{% if forloop.index > 4 %} hidden lg:block{% endif %}" data-clamp="1">{{ t.title }}</span>{% endfor %}
    {%- if tasks.size == 0 %}<span class="label label--small lg:label--base">Nothing due today</span>{% endif %}
  </div>
  {%- endif %}
</div>
<div class="title_bar">
  <img class="image" src="{{ iosuite_icon }}">
  <span class="title">Today</span>
  <span class="instance">{{ updated }}</span>
</div>
