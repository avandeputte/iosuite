<div class="layout layout--row layout--top layout--stretch-x">
  <div class="grid grid--cols-12 w--full">
    <div class="col--span-7 flex flex--col flex--left gap">
      <div class="flex flex--col flex--left">
        <span class="value value--large">{{ weekday }}</span>
        <span class="title">{{ date }}</span>
      </div>
      {%- if has_calendar %}
      <div class="flex flex--col flex--left gap--small">
        <span class="label label--underline">Today</span>
        {%- for e in events %}
        <div class="item">
          <div class="meta"></div>
          <div class="content">
            <span class="title title--small" data-clamp="1">{{ e.title }}</span>
            <div class="flex gap--small">
              <span class="label label--small">{{ e.time }}</span>
              {%- if e.place != "" %}<span class="label label--small label--gray" data-clamp="1">@ {{ e.place }}</span>{% endif %}
            </div>
          </div>
        </div>
        {%- endfor %}
        {%- if events.size == 0 %}<span class="description">{% if next != "" %}Nothing more today. {{ next }}{% else %}Nothing more today{% endif %}</span>{% endif %}
        {%- if events_more > 0 %}<span class="label label--small label--gray">and {{ events_more }} more</span>{% endif %}
      </div>
      {%- if tomorrow.size > 0 %}
      <div class="flex flex--col flex--left gap--xsmall">
        <span class="label label--underline">Tomorrow</span>
        {%- for e in tomorrow %}
        <span class="label label--small" data-clamp="1">{{ e.time }} &middot; {{ e.title }}{% if e.place != "" %} @ {{ e.place }}{% endif %}</span>
        {%- endfor %}
      </div>
      {%- endif %}
      {%- endif %}
    </div>
    <div class="col--span-5 flex flex--col flex--left gap">
      {%- if weather %}
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="value value--xlarge" data-fit-value="true">{{ weather.temp }}</span>
          <span class="label">{{ weather.text }}</span>
          <span class="label label--small label--gray">{% if weather.hi != "" %}High {{ weather.hi }} &middot; Low {{ weather.lo }}{% endif %}{% if weather.rain != "" %} &middot; Rain {{ weather.rain }}{% endif %}</span>
        </div>
      </div>
      {%- endif %}
      {%- if has_tasks %}
      <div class="flex flex--col flex--left gap--small">
        <span class="label label--underline">Tasks{% if overdue > 0 %} &middot; {{ overdue }} late{% endif %}</span>
        {%- for t in tasks %}
        <div class="item">
          <div class="meta"></div>
          <div class="content">
            <span class="title title--small" data-clamp="1">{{ t.title }}</span>
            {%- if t.when != "" %}<span class="label label--small{% if t.late %} label--inverted{% endif %}">{{ t.when }}</span>{% endif %}
          </div>
        </div>
        {%- endfor %}
        {%- if tasks.size == 0 %}<span class="description">Nothing due today</span>{% endif %}
        {%- if tasks_more > 0 %}<span class="label label--small label--gray">and {{ tasks_more }} more</span>{% endif %}
      </div>
      {%- endif %}
      {%- for b in birthdays %}<span class="label label--small label--outline" data-clamp="1">{{ b }}</span>{% endfor %}
    </div>
  </div>
</div>
<div class="title_bar">
  <img class="image" src="{{ iosuite_icon }}">
  <span class="title">Today</span>
  <span class="instance">{{ date_short }} &middot; updated {{ updated }}</span>
</div>
