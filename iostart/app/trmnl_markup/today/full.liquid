<div class="layout layout--col layout--top layout--stretch-x gap lg:gap--large">
  <div class="flex flex--row flex--between w--full">
    <div class="flex flex--col flex--left">
      <span class="value value--large lg:value--xxlarge">{{ weekday }}</span>
      <span class="title lg:title--xlarge">{{ date }}</span>
    </div>
    {%- if weather %}
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <div class="flex flex--row flex--left gap lg:gap--large">
          <img class="image w--16 h--16 lg:w--24 lg:h--24 {{ grays_only }}" src="data:image/svg+xml;base64,{{ wx_open | append: wx[weather.icon] | append: '</svg>' | base64_encode }}"><img class="image w--16 h--16 lg:w--24 lg:h--24 {{ inks_only }}" src="data:image/svg+xml;base64,{{ wx_open | append: wx_ink[weather.icon] | append: '</svg>' | base64_encode }}">
          <span class="value value--xlarge lg:value--xxlarge">{{ weather.temp }}</span>
        </div>
        <span class="label lg:label--large">{{ weather.text }}{% if weather.hi != "" %} &middot; High {{ weather.hi }} &middot; Low {{ weather.lo }}{% endif %}{% if weather.rain != "" %} &middot; Rain {{ weather.rain }}{% endif %}</span>
      </div>
    </div>
    {%- endif %}
  </div>
  <div class="columns gap--[9px]" data-overflow="true" data-overflow-max-cols="3" data-overflow-counter="true">
    <div class="column">
      {%- for g in list %}
      <span class="label label--underline group-header" data-group-header="true">{{ g.label }}</span>
      {%- for r in g.rows %}
      <div class="item">
        <div class="meta">{% if r.ink != blank %}<div class="bg--{{ r.ink }} w--full h--full {{ inks_only }}"></div>{% endif %}</div>
        <div class="content">
          <span class="title title--small lg:text--xlarge lg:text--bold" data-clamp="1">{{ r.title }}</span>
          <span class="label label--small lg:label--large{% if r.late %} label--error {{ on_grays }}{% endif %}" data-clamp="1">{{ r.when }}{% if r.note != "" %} {{ r.note }}{% endif %}</span>
        </div>
      </div>
      {%- endfor %}
      {%- if g.rows.size == 0 %}<div class="item"><div class="content"><span class="description lg:description--xlarge">{{ none }}</span></div></div>{% endif %}
      {%- if g.more > 0 %}<div class="item"><div class="meta"></div><div class="content"><span class="label label--small label--gray lg:label--large">and {{ g.more }} more today</span></div></div>{% endif %}
      {%- endfor %}
    </div>
  </div>
</div>
<div class="title_bar">
  <img class="image" src="{{ iosuite_icon }}">
  <span class="title">Today</span>
  <span class="instance">{{ date_short }} &middot; updated {{ updated }}</span>
</div>
