# keep the build context small: an image gets its app's code and static files, pyproject.toml, the README and shared/
.git
.github
docs
**/.venv
**/__pycache__
**/*.pyc
**/*.egg-info
**/.pytest_cache
**/tests
**/proxmox
**/config.env
**/data
# ...but not the code that is named data: ioPix's package app/data (without it the image cannot start)
!iopix/app/data
**/*.log
**/.DS_Store
iopix/docs
iopix/site
iopix/installer
iopix/dist
iostart/docs
